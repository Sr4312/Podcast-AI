---
import { render, getEntries } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Waveform from '@/components/Waveform.astro';
import Icono from '@/components/Icono.astro';
import { SITIO, FORMATOS, EJES, TIPOS_FUENTE } from '@/config/sitio';
import { getEpisodios, duracionSegundos, capitulosDe, fechaLarga, fechaISO, picosDe } from '@/lib/contenido';
import { duracionLegible } from '@/lib/tiempo';

export async function getStaticPaths() {
  const episodios = await getEpisodios();
  return episodios.map((ep) => ({ params: { slug: ep.id }, props: { ep } }));
}

const { ep } = Astro.props;
const { Content } = await render(ep);
const capitulos = capitulosDe(ep);
const picos = await picosDe(ep.id);
const invitados = await getEntries(ep.data.invitados);
const titulo = `${ep.data.titulo} · ${SITIO.nombre} #${ep.data.numero}`;
const fuentesPorTipo = Object.entries(TIPOS_FUENTE)
  .map(([tipo, nombre]) => ({ tipo, nombre, fuentes: ep.data.fuentes.filter((f) => f.tipo === tipo) }))
  .filter((g) => g.fuentes.length);
---

<Base titulo={titulo} descripcion={ep.data.bajada} ruta={`/episodios/${ep.id}`} tipoOG="article">
  <div class="cuaderno">
    <div class="margen">
      {ep.data.ejemplo && <p class="aviso-ejemplo mb-5">Contenido de ejemplo: episodio, invitados y cifras ficticios para la demo del sitio.</p>}
      <nav aria-label="Migas" class="mb-4">
        <a href="/episodios">Episodios</a> / N.º {ep.data.numero}
      </nav>
      <dl>
        <div>
          <dt>Publicado</dt>
          <dd><time datetime={fechaISO(ep.data.fecha)}>{fechaLarga(ep.data.fecha)}</time></dd>
        </div>
        <div>
          <dt>Duración</dt>
          <dd class="mono">{duracionLegible(duracionSegundos(ep))}</dd>
        </div>
        <div>
          <dt>Formato</dt>
          <dd>{FORMATOS[ep.data.formato].nombre}</dd>
        </div>
        <div>
          <dt>{ep.data.ejes.length > 1 ? 'Ejes' : 'Eje'}</dt>
          <dd>{ep.data.ejes.map((e) => EJES[e].nombre).join(', ')}</dd>
        </div>
        {
          invitados.length > 0 && (
            <div>
              <dt>{invitados.length > 1 ? 'Invitados' : 'Invitado'}</dt>
              <dd>
                {invitados.map((i, k) => (
                  <>
                    <a href={`/invitados/${i.id}`}>{i.data.nombre}</a>
                    {k < invitados.length - 1 ? ', ' : ''}
                  </>
                ))}
              </dd>
            </div>
          )
        }
      </dl>
    </div>

    <article class="cuerpo">
      <header>
        <p class="meta">Temporada {ep.data.temporada} · Episodio {ep.data.numero}</p>
        <h1 class="mt-2">{ep.data.titulo}</h1>
        <p class="prosa text-lg mt-4">{ep.data.bajada}</p>
        <div class="mt-6"><Waveform picos={picos} barras={160} alto={64} /></div>
        <div class="mt-5 flex flex-wrap items-center gap-x-6 gap-y-3">
          <button type="button" class="boton" data-reproducir={ep.id}><Icono nombre="play" tamano={18} /> Reproducir</button>
          <p class="meta">
            Escuchalo en{' '}
            {ep.data.plataformas.youtube && <a href={ep.data.plataformas.youtube}>YouTube</a>}
            {ep.data.plataformas.spotify && <> · <a href={ep.data.plataformas.spotify}>Spotify</a></>}
            {ep.data.plataformas.apple && <> · <a href={ep.data.plataformas.apple}>Apple Podcasts</a></>}
          </p>
        </div>
      </header>

      {
        ep.data.resumen && (
          <section class="seccion prosa" aria-labelledby="resumen">
            <h2 id="resumen">En 2 minutos</h2>
            <ul>
              {ep.data.resumen.puntos.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <p class="mt-5">{ep.data.resumen.contexto}</p>
            {ep.data.ia && <p class="meta mt-4">Resumen redactado con asistencia de IA y revisado por {ep.data.ia.revisado_por}.</p>}
          </section>
        )
      }

      {
        ep.data.frase && (
          <figure class="seccion frase">
            <blockquote>
              <p>{ep.data.frase.texto}</p>
            </blockquote>
            <figcaption class="meta mt-3">
              {ep.data.frase.autor}, <span class="mono">{ep.data.frase.t}</span>
            </figcaption>
          </figure>
        )
      }

      <section class="seccion prosa" aria-labelledby="capitulos">
        <h2 id="capitulos">Capítulos</h2>
        <ol class="capitulos">
          {
            capitulos.map((c) => (
              <li>
                <a href={`#cap-${c.segundos}`} class="mono meta">{c.t}</a>
                <span>{c.titulo}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="seccion prosa" aria-labelledby="fuentes">
        <h2 id="fuentes">Fuentes y datos citados</h2>
        {
          fuentesPorTipo.map((g) => (
            <div class="mt-6">
              <h3>{g.nombre}</h3>
              <ul class="lista-editorial mt-2" style="list-style:none;padding:0">
                {g.fuentes.map((f) => (
                  <li>
                    <a href={f.url} rel="noopener">{f.titulo}</a>
                    <p class="meta mt-1">
                      {f.organismo}
                      {f.fecha && <> · <time datetime={fechaISO(f.fecha)}>{fechaLarga(f.fecha)}</time></>}
                    </p>
                    <p class="mt-1">{f.nota}</p>
                    <p class="mt-1">
                      {f.verificada ? <span class="estado estado--ok">Verificada</span> : <span class="estado estado--pendiente">Pendiente de verificación</span>}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      {
        ep.data.ia && (
          <section class="seccion prosa" aria-labelledby="ia">
            <h2 id="ia">Cómo usamos IA en este episodio</h2>
            <dl class="ia">
              <dt>Qué hizo la IA</dt>
              <dd>{ep.data.ia.usada_para.join('; ')}.</dd>
              <dt>Qué no hizo</dt>
              <dd>{ep.data.ia.no_usada_para.join('; ')}.</dd>
              <dt>Quién revisó</dt>
              <dd>{ep.data.ia.revisado_por}</dd>
            </dl>
          </section>
        )
      }

      <section class="seccion prosa" aria-labelledby="transcripcion">
        <h2 id="transcripcion">Transcripción completa</h2>
        <p class="meta">Oradores identificados. Cada párrafo tiene su tiempo; hacé clic para saltar o copiá el link a ese momento.</p>
        <div class="transcripcion mt-6">
          <Content />
        </div>
      </section>
    </article>
  </div>
</Base>

<style>
  .frase blockquote {
    margin: 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-acento);
    font-family: var(--font-titulo);
    font-size: var(--text-xl);
    line-height: 1.3;
    max-width: 30ch;
    text-wrap: pretty;
  }
  .capitulos {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .capitulos li {
    display: flex;
    gap: 1rem;
    padding: 0.4rem 0;
    border-top: 1px solid var(--color-linea);
  }
  .capitulos a {
    text-decoration: none;
    min-width: 5.2rem;
  }
  .capitulos a:hover {
    text-decoration: underline;
  }
  .ia dt {
    font-weight: 600;
    margin-top: 0.75rem;
  }
  .ia dd {
    margin: 0;
  }
  .transcripcion :global(h2) {
    font-size: var(--text-xl);
  }
  .transcripcion :global(p + p) {
    margin-top: 1em;
  }
  .transcripcion :global(h2 + p) {
    margin-top: 0;
  }
</style>
