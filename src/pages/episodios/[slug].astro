---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import { SITIO, FORMATOS, EJES, TIPOS_FUENTE } from '@/config/sitio';
import { getEpisodios, duracionSegundos, capitulosDe, fechaLarga, picosDe } from '@/lib/contenido';
import { duracionLegible } from '@/lib/tiempo';

export async function getStaticPaths() {
  const episodios = await getEpisodios();
  return episodios.map((ep) => ({ params: { slug: ep.id }, props: { ep } }));
}

const { ep } = Astro.props;
const { Content } = await render(ep);
const capitulos = capitulosDe(ep);
const picos = await picosDe(ep.id);
const titulo = `${ep.data.titulo} · ${SITIO.nombre} #${ep.data.numero}`;
---

<Base titulo={titulo} descripcion={ep.data.bajada} ruta={`/episodios/${ep.id}`} tipoOG="article">
  {ep.data.ejemplo && <p class="aviso-ejemplo mb-6">Contenido de ejemplo: episodio, invitados y cifras ficticios para la demo del sitio.</p>}

  <nav aria-label="Migas" class="text-[0.9375rem] text-tinta-2">
    <a href="/episodios">Episodios</a> / N.º {ep.data.numero}
  </nav>

  <header class="mt-4">
    <p class="m-0 text-tinta-2">Temporada {ep.data.temporada} · Episodio {ep.data.numero}</p>
    <h1 class="mt-2 mb-3 text-4xl md:text-5xl">{ep.data.titulo}</h1>
    <p class="prosa m-0 text-xl">{ep.data.bajada}</p>
    <p class="mt-3 text-tinta-2">
      <time datetime={ep.data.fecha.toISOString().slice(0, 10)}>{fechaLarga(ep.data.fecha)}</time> ·
      <span class="mono">{duracionLegible(duracionSegundos(ep))}</span> · {FORMATOS[ep.data.formato].nombre} ·
      {ep.data.ejes.map((e) => EJES[e].nombre).join(' · ')}
    </p>
  </header>

  {
    picos && (
      <svg class="mt-6 block w-full" viewBox={`0 0 ${picos.length} 100`} preserveAspectRatio="none" height="80" aria-hidden="true">
        {picos.map((p, i) => (
          <rect x={i} y={50 - p * 48} width="0.6" height={Math.max(1, p * 96)} fill="currentColor" />
        ))}
      </svg>
    )
  }

  <section class="prosa mt-10" aria-labelledby="capitulos">
    <h2 id="capitulos" class="text-2xl">Capítulos</h2>
    <ol class="m-0 list-none p-0">
      {
        capitulos.map((c) => (
          <li class="flex gap-3 py-1">
            <a href={`#cap-${c.segundos}`} class="mono text-[0.9375rem]">{c.t}</a>
            <span>{c.titulo}</span>
          </li>
        ))
      }
    </ol>
  </section>

  <section class="prosa mt-10" aria-labelledby="fuentes">
    <h2 id="fuentes" class="text-2xl">Fuentes y datos citados</h2>
    <ul class="m-0 list-none p-0">
      {
        ep.data.fuentes.map((f) => (
          <li class="border-t border-linea py-3">
            <a href={f.url} rel="noopener">{f.titulo}</a>
            <p class="m-0 text-[0.9375rem] text-tinta-2">
              {TIPOS_FUENTE[f.tipo]} · {f.organismo} ·{' '}
              {f.verificada ? <span class="text-ok">Verificada</span> : <span class="text-pendiente">Pendiente de verificación</span>}
            </p>
            <p class="m-0 mt-1">{f.nota}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="prosa mt-10" aria-labelledby="transcripcion">
    <h2 id="transcripcion" class="text-2xl">Transcripción completa</h2>
    <div class="transcripcion">
      <Content />
    </div>
  </section>
</Base>
