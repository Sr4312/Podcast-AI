---
import { render, getEntries } from 'astro:content';
import Base from '@/layouts/Base.astro';
import Waveform from '@/components/Waveform.astro';
import Icono from '@/components/Icono.astro';
import BotonReproducir from '@/components/BotonReproducir.astro';
import BadgePlataforma from '@/components/BadgePlataforma.astro';
import FilaEpisodio from '@/components/FilaEpisodio.astro';
import Newsletter from '@/components/Newsletter.astro';
import JsonLd from '@/components/JsonLd.astro';
import { getCollection } from 'astro:content';
import { SITIO, FORMATOS, EJES, TIPOS_FUENTE } from '@/config/sitio';
import { duracionISO } from '@/lib/tiempo';
import {
  getEpisodios,
  duracionSegundos,
  capitulosDe,
  fechaLarga,
  fechaISO,
  picosDe,
  cargaReproductor,
  relacionados,
  iniciales,
} from '@/lib/contenido';
import { duracionLegible } from '@/lib/tiempo';
import 'lite-youtube-embed/src/lite-yt-embed.css';

export async function getStaticPaths() {
  const episodios = await getEpisodios();
  return episodios.map((ep) => ({ params: { slug: ep.id }, props: { ep, todos: episodios } }));
}

const { ep, todos } = Astro.props;
const { Content } = await render(ep);
const capitulos = capitulosDe(ep);
const picos = await picosDe(ep.id);
const invitados = await getEntries(ep.data.invitados);
const temasEp = await getEntries(ep.data.temas);
const titulo = `${ep.data.titulo} · ${SITIO.nombre} #${ep.data.numero}`;
const fuentesPorTipo = Object.entries(TIPOS_FUENTE)
  .map(([tipo, nombre]) => ({ tipo, nombre, fuentes: ep.data.fuentes.filter((f) => f.tipo === tipo) }))
  .filter((g) => g.fuentes.length);
const rel = relacionados(ep, todos);
const plataformas = (['youtube', 'spotify', 'apple', 'ivoox'] as const).filter((p) => ep.data.plataformas[p]);
const seguimiento = [...ep.data.seguimiento].sort((a, b) => b.fecha.getTime() - a.fecha.getTime());
const correcciones = [...ep.data.correcciones].sort((a, b) => b.fecha.getTime() - a.fecha.getTime());
const conductores = (await getCollection('conductores')).sort((a, b) => a.data.orden - b.data.orden);
const urlEp = `${SITIO.url}/episodios/${ep.id}`;
const persona = (nombre: string, url?: string) => ({ '@type': 'Person', name: nombre, ...(url ? { url } : {}) });
const jsonLdEpisodio = {
  '@context': 'https://schema.org',
  '@type': 'PodcastEpisode',
  name: ep.data.titulo,
  description: ep.data.bajada,
  url: urlEp,
  datePublished: fechaISO(ep.data.fecha),
  episodeNumber: ep.data.numero,
  partOfSeason: { '@type': 'PodcastSeason', seasonNumber: ep.data.temporada, name: `Temporada ${ep.data.temporada}` },
  partOfSeries: { '@type': 'PodcastSeries', name: SITIO.nombre, url: SITIO.url, webFeed: SITIO.hosting.rss },
  image: `${SITIO.url}/og/${ep.id}.png`,
  inLanguage: 'es-AR',
  timeRequired: duracionISO(duracionSegundos(ep)),
  associatedMedia: {
    '@type': 'AudioObject',
    contentUrl: ep.data.audio?.url.startsWith('/') ? `${SITIO.url}${ep.data.audio.url}` : ep.data.audio?.url,
    encodingFormat: ep.data.audio?.tipo ?? 'audio/mpeg',
    duration: duracionISO(duracionSegundos(ep)),
    ...(ep.data.audio?.bytes ? { contentSize: String(ep.data.audio.bytes) } : {}),
  },
  author: conductores.map((c) => persona(c.data.nombre)),
  actor: invitados.map((i) => persona(i.data.nombre, `${SITIO.url}/invitados/${i.id}`)),
  keywords: temasEp.map((t) => t.data.nombre).join(', '),
  ...(ep.data.youtube ? { video: { '@type': 'VideoObject', name: ep.data.titulo, embedUrl: `https://www.youtube-nocookie.com/embed/${ep.data.youtube}` } } : {}),
  transcript: `${urlEp}/transcripcion.vtt`,
};
---

<Base
  titulo={titulo}
  descripcion={ep.data.bajada}
  ruta={`/episodios/${ep.id}`}
  tipoOG="article"
  imagen={`/og/${ep.id}.png`}
  migas={[{ nombre: 'Episodios', ruta: '/episodios' }, { nombre: `N.º ${ep.data.numero}` }]}
>
  <JsonLd datos={jsonLdEpisodio} slot="head" />
  <div class="cuaderno" data-pagina-episodio data-episodio={JSON.stringify(cargaReproductor(ep))}>
    <div class="margen">
      {ep.data.ejemplo && <p class="aviso-ejemplo mb-5">Contenido de ejemplo: episodio, invitados y cifras ficticios para la demo del sitio.</p>}
      <nav aria-label="Migas" class="mb-4">
        <a href="/episodios">Episodios</a> / N.º {ep.data.numero}
      </nav>
      <dl>
        <div>
          <dt>Publicado</dt>
          <dd><time datetime={fechaISO(ep.data.fecha)}>{fechaLarga(ep.data.fecha)}</time></dd>
        </div>
        <div>
          <dt>Duración</dt>
          <dd class="mono">{duracionLegible(duracionSegundos(ep))}</dd>
        </div>
        <div>
          <dt>Formato</dt>
          <dd>{FORMATOS[ep.data.formato].nombre}</dd>
        </div>
        <div>
          <dt>{ep.data.ejes.length > 1 ? 'Ejes' : 'Eje'}</dt>
          <dd>{ep.data.ejes.map((e, k) => <><a href={`/temas#${e}`}>{EJES[e].nombre}</a>{k < ep.data.ejes.length - 1 ? ', ' : ''}</>)}</dd>
        </div>
        <div>
          <dt>Temas</dt>
          <dd>{temasEp.map((t, k) => <><a href={`/temas/${t.id}`}>{t.data.nombre}</a>{k < temasEp.length - 1 ? ', ' : ''}</>)}</dd>
        </div>
        {
          invitados.length > 0 && (
            <div>
              <dt>{invitados.length > 1 ? 'Invitados' : 'Invitado'}</dt>
              <dd>{invitados.map((i, k) => <><a href={`/invitados/${i.id}`}>{i.data.nombre}</a>{k < invitados.length - 1 ? ', ' : ''}</>)}</dd>
            </div>
          )
        }
      </dl>
    </div>

    <article class="cuerpo" data-pagefind-body data-pagefind-meta={`numero:${ep.data.numero}`} data-pagefind-filter={`formato:${FORMATOS[ep.data.formato].nombre}`}>
      <header>
        <p class="rotulo" data-pagefind-meta={`formato:${FORMATOS[ep.data.formato].nombre}`}>
          Temporada {ep.data.temporada} · Episodio <span transition:name={`n-${ep.id}`}>{ep.data.numero}</span>
        </p>
        <h1 class="mt-2" transition:name={`titulo-${ep.id}`}>{ep.data.titulo}</h1>
        <p class="prosa text-lg mt-4">{ep.data.bajada}</p>
        <div class="mt-6"><Waveform picos={picos} barras={160} alto={64} degradado /></div>
        <div class="mt-5 flex flex-wrap items-center gap-3">
          <BotonReproducir ep={ep} principal />
          {
            ep.data.youtube && (
              <button type="button" class="boton boton--secundario" data-ver-video aria-expanded="false" aria-controls="video">
                <Icono nombre="video" tamano={18} /> Ver en video
              </button>
            )
          }
        </div>
        {
          ep.data.youtube && (
            <div id="video" class="video mt-4" hidden>
              <lite-youtube videoid={ep.data.youtube} playlabel={`Reproducir en YouTube: ${ep.data.titulo}`} params="rel=0&hl=es" />
            </div>
          )
        }
        {
          plataformas.length > 0 && (
            <div class="mt-5">
              <p class="meta mb-2">Escuchalo en</p>
              <div class="flex flex-wrap gap-2">
                {plataformas.map((p) => (
                  <BadgePlataforma id={p} href={ep.data.plataformas[p]!} episodioId={ep.id} />
                ))}
              </div>
            </div>
          )
        }
      </header>

      {
        ep.data.resumen && (
          <section class="seccion prosa" aria-labelledby="resumen">
            <h2 id="resumen">En 2 minutos</h2>
            <ul>
              {ep.data.resumen.puntos.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
            <p class="mt-5">{ep.data.resumen.contexto}</p>
            {ep.data.ia && <p class="meta mt-4">Resumen redactado con asistencia de IA y revisado por {ep.data.ia.revisado_por}.</p>}
          </section>
        )
      }

      {
        ep.data.frase && (
          <figure class="seccion frase">
            <blockquote>
              <p>{ep.data.frase.texto}</p>
            </blockquote>
            <figcaption class="meta mt-3 flex flex-wrap items-center gap-x-4 gap-y-2">
              <span>
                {ep.data.frase.autor}, <button type="button" class="ts mono" data-t={capitulos.length ? undefined : undefined} data-frase-t={ep.data.frase.t}>{ep.data.frase.t}</button>
              </span>
              <a href={`/kit/${ep.id}`} class="boton boton--secundario" style="min-height:2.25rem"><Icono nombre="compartir" tamano={16} /> Compartir</a>
            </figcaption>
          </figure>
        )
      }

      <section class="seccion prosa" aria-labelledby="capitulos">
        <h2 id="capitulos">Capítulos</h2>
        <ol class="capitulos">
          {
            capitulos.map((c) => (
              <li>
                <a href={`#cap-${c.segundos}`} class="mono meta">{c.t}</a>
                <span>{c.titulo}</span>
              </li>
            ))
          }
        </ol>
      </section>

      <section class="seccion prosa" aria-labelledby="fuentes">
        <h2 id="fuentes">Fuentes y datos citados</h2>
        <p class="meta">
          {ep.data.fuentes.filter((f) => f.verificada).length} de {ep.data.fuentes.length} verificadas por el equipo. Las pendientes están marcadas. <a href="/fuentes">Biblioteca completa</a>.
        </p>
        {
          fuentesPorTipo.map((g) => (
            <div class="mt-6">
              <h3>{g.nombre}</h3>
              <ul class="lista-editorial mt-2" style="list-style:none;padding:0">
                {g.fuentes.map((f) => (
                  <li>
                    <a href={f.url} rel="noopener">{f.titulo}</a>
                    <p class="meta mt-1">
                      {f.organismo}
                      {f.fecha && <> · <time datetime={fechaISO(f.fecha)}>{fechaLarga(f.fecha)}</time></>}
                    </p>
                    <p class="mt-1">{f.nota}</p>
                    <p class="mt-1">
                      {f.verificada ? <span class="estado estado--ok">Verificada</span> : <span class="estado estado--pendiente">Pendiente de verificación</span>}
                    </p>
                  </li>
                ))}
              </ul>
            </div>
          ))
        }
      </section>

      {
        ep.data.ia && (
          <section class="seccion prosa" aria-labelledby="ia">
            <h2 id="ia">Cómo usamos IA en este episodio</h2>
            <dl class="ia">
              <dt>Qué hizo la IA</dt>
              <dd>{ep.data.ia.usada_para.join('; ')}.</dd>
              <dt>Qué no hizo</dt>
              <dd>{ep.data.ia.no_usada_para.join('; ')}.</dd>
              <dt>Quién revisó</dt>
              <dd>{ep.data.ia.revisado_por}</dd>
            </dl>
            <p class="meta mt-4"><a href="/acerca#ia">Nuestra política de uso de IA</a></p>
          </section>
        )
      }

      {
        invitados.length > 0 && (
          <section class="seccion prosa" aria-labelledby="invitados">
            <h2 id="invitados">{invitados.length > 1 ? 'Invitados' : 'Invitado'}</h2>
            <ul class="personas">
              {invitados.map((i) => (
                <li class="persona">
                  {i.data.foto ? (
                    <img src={i.data.foto.src} width="72" height="72" alt={`Foto de ${i.data.nombre}`} class="persona__foto" loading="lazy" />
                  ) : (
                    <span class="persona-sin-foto" aria-hidden="true">{iniciales(i.data.nombre)}</span>
                  )}
                  <div>
                    <p>
                      <a href={`/invitados/${i.id}`} class="font-titulo text-xl">{i.data.nombre}</a>
                    </p>
                    <p class="meta">{i.data.rol}{i.data.organizacion && <>, {i.data.organizacion}</>}</p>
                    <p class="mt-2">{(i.body ?? '').split('\n\n')[0]}</p>
                    <p class="meta mt-2">
                      {i.data.conflictos.length ? <>Conflictos declarados: {i.data.conflictos.join(' ')}</> : 'Sin conflictos declarados.'}
                    </p>
                  </div>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        seguimiento.length > 0 && (
          <section class="seccion prosa" aria-labelledby="despues">
            <h2 id="despues">¿Qué pasó después?</h2>
            <ul class="cronologia">
              {seguimiento.map((s) => (
                <li>
                  <time datetime={fechaISO(s.fecha)} class="meta">{fechaLarga(s.fecha)}</time>
                  <p>{s.texto}</p>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </article>
  </div>

  <div class="cuaderno seccion" id="transcripcion-zona">
    <aside class="margen indice-fijo" aria-label="Índice de la transcripción">
      <p class="font-semibold text-tinta mb-2">Transcripción</p>
      <ol class="indice-capitulos">
        {
          capitulos.map((c) => (
            <li>
              <a href={`#cap-${c.segundos}`}><span class="mono">{c.t.slice(0, 5) === '00:00' ? c.t.slice(3) : c.t.slice(3)}</span> {c.titulo}</a>
            </li>
          ))
        }
      </ol>
      <button type="button" class="boton boton--secundario mt-4" data-seguir-lectura aria-pressed="false" style="min-height:2.25rem">
        Seguir lectura
      </button>
      <p class="mt-2">Con "Seguir lectura" activado, el párrafo que suena queda resaltado y la página lo acompaña.</p>
    </aside>
    <section class="cuerpo prosa" aria-labelledby="transcripcion" data-pagefind-body>
      <h2 id="transcripcion">Transcripción completa</h2>
      <p class="meta">
        Oradores identificados. Cada párrafo tiene su tiempo: hacé clic para escuchar desde ahí o copiá el link a ese momento. Los términos
        con subrayado punteado están en el <a href="/glosario">glosario</a>.
      </p>
      <div class="transcripcion mt-6">
        <Content />
      </div>
    </section>
  </div>

  <div class="cuaderno seccion">
    <div class="margen"></div>
    <div class="cuerpo">
      {
        correcciones.length > 0 && (
          <section class="prosa" aria-labelledby="correcciones">
            <h2 id="correcciones">Correcciones</h2>
            <ul class="cronologia">
              {correcciones.map((c) => (
                <li>
                  <time datetime={fechaISO(c.fecha)} class="meta">{fechaLarga(c.fecha)}</time>
                  <p>{c.texto}</p>
                </li>
              ))}
            </ul>
            <p class="meta mt-3"><a href="/correcciones">Todas las correcciones del podcast</a></p>
          </section>
        )
      }

      {
        rel.length > 0 && (
          <section class={correcciones.length ? 'seccion' : ''} aria-labelledby="relacionados">
            <h2 id="relacionados" class="mb-4">Episodios relacionados</h2>
            <ol class="lista-editorial">
              {rel.map((r) => (
                <FilaEpisodio ep={r} conBajada={false} />
              ))}
            </ol>
          </section>
        )
      }

      <section class="seccion" aria-labelledby="news">
        <h2 id="news" class="mb-3">{SITIO.newsletter.nombreLista}</h2>
        <p class="prosa mb-4">Un correo por episodio, con el resumen, las fuentes y lo que pasó después. Nada más.</p>
        <Newsletter id="news-ep" />
      </section>
    </div>
  </div>
</Base>

<script>
  import 'lite-youtube-embed';
  import { $episodio, $tiempo, $capituloActual, leerPosicion, cargarEpisodio, type EpisodioCarga } from '@/stores/reproductor';
  import { aSegundos, formatoCorto } from '@/lib/tiempo';

  let desuscribir: (() => void)[] = [];

  function init() {
    desuscribir.forEach((f) => f());
    desuscribir = [];
    const raiz = document.querySelector<HTMLElement>('[data-pagina-episodio]');
    if (!raiz) return;
    const carga: EpisodioCarga = JSON.parse(raiz.dataset.episodio!);
    const principal = raiz.querySelector<HTMLElement>('[data-reproducir-principal]');
    const texto = principal?.querySelector<HTMLElement>('.texto');
    if (texto && !texto.dataset.original) texto.dataset.original = texto.textContent || 'Reproducir';

    // Deep link ?t=754: posiciona el reproductor sin autoplay y ofrece "Reproducir desde".
    const t = new URLSearchParams(location.search).get('t');
    const seg = t && /^\d+$/.test(t) ? Number(t) : null;
    if (seg !== null && seg < carga.duracion) {
      cargarEpisodio(carga, { t: seg, autoplay: false });
      if (principal && texto) {
        principal.dataset.desde = String(seg);
        texto.textContent = `Reproducir desde ${formatoCorto(seg)}`;
      }
      document.getElementById(`t-${seg}`)?.scrollIntoView({ block: 'center' });
    } else if (principal && texto && $episodio.get()?.id !== carga.id) {
      const pos = leerPosicion(carga.id);
      if (pos) {
        principal.dataset.desde = String(pos);
        texto.textContent = `Seguir desde ${formatoCorto(pos)}`;
      }
    }

    // Frase destacada: su tiempo también salta.
    raiz.querySelector<HTMLElement>('[data-frase-t]')?.addEventListener('click', (e) => {
      const hms = (e.currentTarget as HTMLElement).dataset.fraseT!;
      cargarEpisodio(carga, { t: aSegundos(hms), autoplay: true });
    });

    // Ver en video: la fachada de lite-youtube no carga nada hasta el clic.
    const btnVideo = raiz.querySelector<HTMLButtonElement>('[data-ver-video]');
    const video = document.getElementById('video');
    btnVideo?.addEventListener('click', () => {
      const abierto = video!.hidden;
      video!.hidden = !abierto;
      btnVideo.setAttribute('aria-expanded', String(abierto));
    });

    // Capítulo en curso: lista de capítulos e índice fijo.
    const items = document.querySelectorAll<HTMLElement>('.capitulos li, .indice-capitulos li');
    const marcarCapitulo = () => {
      const ep = $episodio.get();
      const cap = $capituloActual.get();
      items.forEach((li) => {
        const href = li.querySelector('a')?.getAttribute('href');
        const activo = !!ep && ep.id === carga.id && !!cap && href === `#cap-${cap.t}`;
        li.classList.toggle('en-curso', activo);
        if (activo) li.setAttribute('aria-current', 'true');
        else li.removeAttribute('aria-current');
      });
    };
    desuscribir.push($capituloActual.subscribe(marcarCapitulo), $episodio.subscribe(marcarCapitulo));

    // Seguir lectura: párrafo en curso resaltado y la página acompaña.
    const btnSeguir = document.querySelector<HTMLButtonElement>('[data-seguir-lectura]');
    const parrafos = Array.from(document.querySelectorAll<HTMLElement>('.transcripcion .parrafo'));
    const tiempos = parrafos.map((p) => Number(p.dataset.t));
    let seguir = false;
    try {
      seguir = localStorage.getItem('seguir-lectura') === '1';
    } catch {}
    let ultimo: HTMLElement | null = null;
    const pintar = () => {
      btnSeguir?.setAttribute('aria-pressed', String(seguir));
      if (!seguir || $episodio.get()?.id !== carga.id) {
        ultimo?.classList.remove('en-curso');
        ultimo = null;
        return;
      }
      const t = $tiempo.get();
      let idx = -1;
      for (let i = 0; i < tiempos.length; i++) {
        if (tiempos[i] <= t) idx = i;
        else break;
      }
      const actual = idx >= 0 ? parrafos[idx] : null;
      if (actual === ultimo) return;
      ultimo?.classList.remove('en-curso');
      actual?.classList.add('en-curso');
      actual?.scrollIntoView({ block: 'center', behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
      ultimo = actual;
    };
    btnSeguir?.addEventListener('click', () => {
      seguir = !seguir;
      try {
        localStorage.setItem('seguir-lectura', seguir ? '1' : '0');
      } catch {}
      pintar();
    });
    desuscribir.push($tiempo.subscribe(pintar), $episodio.subscribe(pintar));

    // Tooltip accesible del glosario.
    let tip = document.getElementById('tooltip-glosario');
    if (!tip) {
      tip = document.createElement('div');
      tip.id = 'tooltip-glosario';
      tip.className = 'tooltip-glosario';
      tip.setAttribute('role', 'tooltip');
      tip.hidden = true;
      document.body.appendChild(tip);
    }
    const mostrar = (a: HTMLElement) => {
      tip!.innerHTML = `<strong>${a.dataset.termino}</strong>${a.dataset.def}`;
      tip!.hidden = false;
      const r = a.getBoundingClientRect();
      const ancho = Math.min(352, window.innerWidth - 32);
      const izq = Math.min(Math.max(16, r.left + window.scrollX), window.scrollX + window.innerWidth - ancho - 16);
      tip!.style.left = `${izq}px`;
      tip!.style.top = `${r.bottom + window.scrollY + 8}px`;
      a.setAttribute('aria-describedby', 'tooltip-glosario');
    };
    const ocultar = (a: HTMLElement) => {
      tip!.hidden = true;
      a.removeAttribute('aria-describedby');
    };
    document.querySelectorAll<HTMLElement>('a.glosario[data-def]').forEach((a) => {
      a.addEventListener('mouseenter', () => mostrar(a));
      a.addEventListener('mouseleave', () => ocultar(a));
      a.addEventListener('focus', () => mostrar(a));
      a.addEventListener('blur', () => ocultar(a));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && tip) tip.hidden = true;
    });
  }
  document.addEventListener('astro:page-load', init);
</script>

<style>
  .frase blockquote {
    margin: 0;
    padding-left: 1.25rem;
    border-left: 3px solid var(--color-acento);
    font-family: var(--font-titulo);
    font-size: var(--text-xl);
    line-height: 1.3;
    max-width: 30ch;
    text-wrap: pretty;
  }
  .frase .ts {
    color: var(--color-acento);
  }
  .capitulos {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .capitulos li {
    display: flex;
    gap: 1rem;
    padding: 0.4rem 0;
