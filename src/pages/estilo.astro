---
import Base from '@/layouts/Base.astro';
import Waveform from '@/components/Waveform.astro';
import Icono from '@/components/Icono.astro';
import { SITIO } from '@/config/sitio';
import { getEpisodios, picosDe } from '@/lib/contenido';

const [ultimo] = await getEpisodios();
const picos = ultimo ? await picosDe(ultimo.id) : null;

const colores = [
  { nombre: 'Papel', token: '--color-papel', uso: 'Fondo de página.' },
  { nombre: 'Papel 2', token: '--color-papel-2', uso: 'Fondos secundarios: bloques de cita, inputs.' },
  { nombre: 'Tinta', token: '--color-tinta', uso: 'Texto principal, botón primario.' },
  { nombre: 'Tinta 2', token: '--color-tinta-2', uso: 'Metadatos y texto secundario. Nunca por debajo de 4,5:1.' },
  { nombre: 'Línea', token: '--color-linea', uso: 'Separadores de listas y bordes.' },
  { nombre: 'Marca', token: '--color-marca', uso: 'Naranja señal: logo, botón principal, waveform, rótulos. Sobre ella el texto va en tinta oscura.' },
  { nombre: 'Marca texto', token: '--color-marca-texto', uso: 'La marca cuando es texto (números de episodio): pasa 4,5:1 sobre papel.' },
  { nombre: 'Marca suave', token: '--color-marca-suave', uso: 'Hover de filas, selección de texto, panel de newsletter.' },
  { nombre: 'Acento', token: '--color-acento', uso: 'Links, estado de reproducción, capítulo en curso.' },
  { nombre: 'Acento suave', token: '--color-acento-suave', uso: 'Fondo del párrafo en curso y hover de timestamps.' },
  { nombre: 'Verificada', token: '--color-ok', uso: 'Solo para el estado de una fuente verificada.' },
  { nombre: 'Pendiente', token: '--color-pendiente', uso: 'Fuente pendiente de verificación y avisos de contenido de ejemplo.' },
  { nombre: 'Onda', token: '--color-onda', uso: 'Barras de la waveform sin reproducir.' },
  { nombre: 'Estudio', token: '--color-estudio', uso: 'Superficie oscura de la consola del hero y del pie, en ambos modos.' },
];

const escala = [
  { nombre: 'Titular', clase: 'text-5xl', muestra: 'Chatbots contra el Boletín Oficial', fuente: 'Newsreader 450' },
  { nombre: 'H2', clase: 'text-2xl', muestra: 'Fuentes y datos citados', fuente: 'Newsreader 500' },
  { nombre: 'H3', clase: 'text-xl', muestra: 'Ley o norma', fuente: 'Newsreader 500' },
  { nombre: 'Bajada', clase: 'text-lg', muestra: 'Un modelo de lenguaje y una asesora legislativa analizan el mismo proyecto.', fuente: 'Public Sans 400' },
  { nombre: 'Cuerpo', clase: 'text-base', muestra: 'El modelo encontró todos los artículos. Lo que no encontró fue el pasillo.', fuente: 'Public Sans 400 · 18 px · 1,6' },
  { nombre: 'Metadato', clase: 'text-meta', muestra: '3 de septiembre de 2026 · Laboratorio · 38 min', fuente: 'Public Sans 400 · mín. 14 px' },
  { nombre: 'Tiempo', clase: 'text-meta mono', muestra: '00:23:41 / 00:38:20', fuente: 'IBM Plex Mono · tabular' },
];
---

<Base titulo={`Guía de estilo · ${SITIO.nombre}`} descripcion="Guía de estilo viva del sitio: tokens, tipografía, color y componentes." ruta="/estilo" noindex>
  <div class="cuaderno">
    <div class="margen">
      <dl>
        <div>
          <dt>Documento</dt>
          <dd>Guía de estilo viva</dd>
        </div>
        <div>
          <dt>Estado</dt>
          <dd>Se actualiza con cada fase. No se indexa.</dd>
        </div>
        <div>
          <dt>Concepto</dt>
          <dd>Revista de política pública. La tipografía y el contenido hacen el diseño.</dd>
        </div>
      </dl>
    </div>
    <div class="cuerpo">
      <h1>Guía de estilo</h1>
      <p class="prosa text-lg mt-4">
        Papel y tinta, naranja señal como marca, azul como acento, una waveform real por episodio. Nada que no esté en esta página debería aparecer en el sitio.
      </p>

      <section class="seccion" aria-labelledby="e-color">
        <h2 id="e-color">Color</h2>
        <p class="prosa">
          Base de papel y tinta con dos colores: el naranja señal es la marca (identidad, acción principal, waveform) y el azul es el acento
          semántico (links, estado de reproducción, capítulo en curso). Verde y ámbar existen solo para el estado de las fuentes.
        </p>
        <ul class="muestras mt-6">
          {
            colores.map((c) => (
              <li>
                <span class="muestra" style={`background: var(${c.token})`} />
                <div>
                  <strong>{c.nombre}</strong>
                  <code class="mono">{c.token}</code>
                  <p class="meta">{c.uso}</p>
                </div>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="seccion" aria-labelledby="e-tipo">
        <h2 id="e-tipo">Tipografía</h2>
        <p class="prosa">
          Newsreader para titulares (tiene ejes ópticos y fue diseñada para pantalla), Public Sans para texto y metadatos, IBM Plex Mono
          solo para tiempos. Cuerpo de 18 px en desktop y 17 px en mobile, interlineado 1,6, medida de 66 caracteres. Números tabulares en
          duraciones, timestamps y tablas.
        </p>
        <ul class="escala mt-6">
          {
            escala.map((e) => (
              <li>
                <span class="meta">{e.nombre} · {e.fuente}</span>
                <span class={e.clase + (e.clase.includes('xl') ? ' font-titulo' : '')} style="line-height:1.15">
                  {e.muestra}
                </span>
              </li>
            ))
          }
        </ul>
      </section>

      <section class="seccion" aria-labelledby="e-ret">
        <h2 id="e-ret">Retícula de cuaderno</h2>
        <p class="prosa">
          En pantallas anchas, una columna de 11 rem a la izquierda lleva los metadatos (fecha, duración, formato, invitados) y la columna
          de lectura va a la derecha. Es el único recurso de layout que se repite: lo que no es contenido, va al margen. En mobile, las dos
          columnas se apilan.
        </p>
      </section>

      <section class="seccion" aria-labelledby="e-onda">
        <h2 id="e-onda">Waveform</h2>
        <p class="prosa">
          Picos reales del audio, calculados con ffmpeg. Es la única imagen del sitio: hero, listados, barra del reproductor, OG y kit de
          redes. Las barras reproducidas se pintan con el acento.
        </p>
        <div class="mt-6">
          <p class="meta">Hero · 160 barras</p>
          <Waveform picos={picos} barras={160} alto={72} progreso={0.37} />
          <p class="meta mt-4">Listado · 64 barras</p>
          <div style="max-width: 18rem"><Waveform picos={picos} barras={64} alto={28} /></div>
        </div>
      </section>

      <section class="seccion" aria-labelledby="e-comp">
        <h2 id="e-comp">Componentes</h2>
        <h3 class="mt-6">Botones</h3>
        <p class="prosa meta">Primario para la acción principal de la página (una sola), acento solo para Suscribite, secundario para el resto.</p>
        <p class="mt-3 flex flex-wrap gap-3">
          <button type="button" class="boton"><Icono nombre="play" tamano={18} /> Reproducir</button>
          <a href="/suscribirse" class="boton boton--acento">Suscribite</a>
          <button type="button" class="boton boton--secundario">Copiar link</button>
          <button type="button" class="boton boton--icono boton--secundario" aria-label="Atrasar 15 segundos"><Icono nombre="atras15" /></button>
        </p>

        <h3 class="mt-8">Estados de fuente</h3>
        <p class="mt-3 flex flex-wrap gap-5">
          <span class="estado estado--ok">Verificada</span>
          <span class="estado estado--pendiente">Pendiente de verificación</span>
        </p>

        <h3 class="mt-8">Aviso de contenido de ejemplo</h3>
        <p class="aviso-ejemplo mt-3">Contenido de ejemplo: episodio, invitados y cifras ficticios para la demo del sitio.</p>

        <h3 class="mt-8">Lista editorial</h3>
        <ol class="lista-editorial mt-3">
          <li class="flex gap-4">
            <span class="mono meta w-8 shrink-0">03</span>
            <div>
              <span class="font-titulo text-xl">Chatbots contra el Boletín Oficial</span>
              <p class="meta">Investigación · <span class="mono">46 min</span></p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="mono meta w-8 shrink-0">02</span>
            <div>
              <span class="font-titulo text-xl">El chatbot de un municipio, seis meses después</span>
              <p class="meta">Caso · <span class="mono">41 min</span></p>
            </div>
          </li>
        </ol>

        <h3 class="mt-8">Transcripción</h3>
        <div class="prosa mt-3">
          <p class="parrafo" id="t-ejemplo" data-t="754">
            <button type="button" class="ts" data-t="754" aria-label="Saltar a 00:12:34">00:12:34</button><button
              type="button"
              class="copiar-t"
              aria-label="Copiar link a este momento"><Icono nombre="enlace" tamano={16} /></button
            ><strong class="orador">Carolina Bustos:</strong> El modelo encontró todos los artículos. Lo que no encontró fue el <a
              href="/glosario/prompt"
              class="glosario">pasillo</a
            >.
          </p>
          <p class="parrafo en-curso mt-4" data-t="776">
            <button type="button" class="ts" data-t="776" aria-label="Saltar a 00:12:56">00:12:56</button><strong class="orador"
              >Martín Albarracín:</strong
            > Este es el párrafo en curso cuando el modo "Seguir lectura" está activo.
          </p>
        </div>
      </section>

      <section class="seccion" aria-labelledby="e-no">
        <h2 id="e-no">Lo que no se hace</h2>
        <ul class="prosa mt-4">
          <li>Gradientes, blobs, glassmorphism, bordes con glow, sombras difusas.</li>
          <li>La última palabra del título en color de acento. Etiquetas "eyebrow" sobre las secciones.</li>
          <li>Grillas de cards idénticas con ícono arriba. Emojis como íconos. Navbar flotante en píldora.</li>
          <li>Hero centrado con dos botones. Copy del tipo "Revolucionando…" o "El futuro de…".</li>
          <li>Cifras, logos o testimonios que no salgan de una fuente.</li>
          <li>Texto por debajo de 14 px o con contraste menor a 4,5:1.</li>
        </ul>
      </section>
    </div>
  </div>
</Base>

<style>
  .muestras {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 1rem 2rem;
    grid-template-columns: repeat(auto-fill, minmax(17rem, 1fr));
  }
  .muestras li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .muestra {
    flex: none;
    width: 3rem;
    height: 3rem;
    border: 1px solid var(--color-linea);
    border-radius: var(--radius-ui);
  }
  .muestras code {
    display: block;
    font-size: var(--text-meta);
    color: var(--color-tinta-2);
  }
  .escala {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .escala li {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding: 1rem 0;
    border-top: 1px solid var(--color-linea);
  }
  .text-meta {
    font-size: var(--text-meta);
  }
</style>
