---
import { getCollection, getEntries, render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import FilaEpisodio from '@/components/FilaEpisodio.astro';
import { SITIO } from '@/config/sitio';
import { getEpisodios, episodiosConTermino } from '@/lib/contenido';

export async function getStaticPaths() {
  const terminos = await getCollection('glosario');
  return terminos.map((t) => ({ params: { termino: t.id }, props: { t } }));
}

const { t } = Astro.props;
const { Content } = await render(t);
const episodios = episodiosConTermino(t, await getEpisodios());
const relacionados = await getEntries(t.data.relacionados);
const temas = (await getCollection('temas')).filter((x) => x.data.glosario.some((g) => g.id === t.id));
---

<Base titulo={`${t.data.termino} · Glosario · ${SITIO.nombre}`} descripcion={t.data.definicion} ruta={`/glosario/${t.id}`} migas={[{ nombre: 'Glosario', ruta: '/glosario' }, { nombre: t.data.termino }]}>
  <div class="cuaderno">
    <div class="margen">
      <nav aria-label="Migas" class="mb-4"><a href="/glosario">Glosario</a></nav>
      <dl>
        {t.data.sinonimos.length > 0 && <div><dt>También</dt><dd>{t.data.sinonimos.join(', ')}</dd></div>}
        {temas.length > 0 && <div><dt>Temas</dt><dd>{temas.map((x, k) => <><a href={`/temas/${x.id}`}>{x.data.nombre}</a>{k < temas.length - 1 ? ', ' : ''}</>)}</dd></div>}
      </dl>
    </div>
    <article class="cuerpo" data-pagefind-body data-pagefind-meta="tipo:Glosario">
      <h1>{t.data.termino}</h1>
      <p class="prosa text-lg mt-4">{t.data.definicion}</p>
      <div class="prosa mt-6 cuerpo-termino">
        <Content />
      </div>

      {
        relacionados.length > 0 && (
          <section class="seccion prosa" aria-labelledby="rel">
            <h2 id="rel">Términos relacionados</h2>
            <ul class="mt-3">
              {relacionados.map((r) => (
                <li>
                  <a href={`/glosario/${r.id}`}>{r.data.termino}</a>: {r.data.definicion}
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section class="seccion" aria-labelledby="eps">
        <h2 id="eps" class="mb-4">Episodios donde aparece</h2>
        {
          episodios.length ? (
            <ol class="lista-editorial">{episodios.map((ep) => <FilaEpisodio ep={ep} conBajada={false} conFecha />)}</ol>
          ) : (
            <p class="prosa">Todavía no aparece en ninguna transcripción.</p>
          )
        }
      </section>
    </article>
  </div>
</Base>

<style>
  .cuerpo-termino :global(p + p) {
    margin-top: 1em;
  }
</style>
