---
import { ClientRouter } from 'astro:transitions';
import { SITIO } from '@/config/sitio';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import '@/styles/global.css';

interface Props {
  titulo: string;
  descripcion: string;
  /** Ruta canónica sin dominio, p. ej. "/episodios/001-..." */
  ruta?: string;
  noindex?: boolean;
  imagen?: string;
  tipoOG?: 'website' | 'article';
}

const { titulo, descripcion, ruta, noindex = false, imagen, tipoOG = 'website' } = Astro.props;
const canonical = new URL(ruta ?? Astro.url.pathname, SITIO.url).toString().replace(/\/$/, '') || SITIO.url;
const ogImagen = new URL(imagen ?? '/og/portada.png', SITIO.url).toString();
---

<!doctype html>
<html lang={SITIO.idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{titulo}</title>
    <meta name="description" content={descripcion.slice(0, 160)} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f2f0eb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#161616" media="(prefers-color-scheme: dark)" />
    <meta property="og:site_name" content={SITIO.nombre} />
    <meta property="og:type" content={tipoOG} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descripcion.slice(0, 200)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImagen} />
    <meta property="og:locale" content="es_AR" />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="alternate" type="application/rss+xml" title={`${SITIO.nombre} (podcast)`} href={SITIO.hosting.rss} />
    <link rel="alternate" type="application/rss+xml" title={`${SITIO.nombre} (novedades de la web)`} href="/rss.xml" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Tema guardado, antes del primer pintado para evitar parpadeo.
      try {
        const t = localStorage.getItem('tema');
        if (t === 'dark' || t === 'light') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <a href="#contenido" class="salto">Saltar al contenido</a>
    <Header />
    <main id="contenido" class="contenedor principal">
      <slot />
    </main>
    <Footer />
    <div id="reproductor" transition:persist="reproductor"></div>
  </body>
</html>

<style>
  .principal {
    padding-top: 2.5rem;
  }
  @media (min-width: 48rem) {
    .principal {
      padding-top: 3.5rem;
    }
  }
  .salto {
    position: absolute;
    left: 1rem;
    top: 0.5rem;
    z-index: 50;
    padding: 0.5rem 0.9rem;
    background: var(--color-tinta);
    color: var(--color-papel);
    border-radius: var(--radius-ui);
    transform: translateY(-200%);
  }
  .salto:focus-visible {
    transform: none;
  }
</style>
